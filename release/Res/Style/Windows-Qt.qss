  image: url(":/Images/Controls_Images_Dark/radio_unchecked.png");
}

QRadioButton::indicator:unchecked:hover, QRadioButton::indicator:unchecked:focus, QRadioButton::indicator:unchecked:pressed {
  border: none;
  outline: none;
  image: url(":/Images/Controls_Images_Dark/radio_unchecked_focus.png");
}

QRadioButton::indicator:unchecked:disabled {
  image: url(":/Images/Controls_Images_Dark/radio_unchecked_disabled.png");
}

QRadioButton::indicator:checked {
  border: none;
