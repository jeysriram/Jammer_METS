QMenu::indicator:non-exclusive:indeterminate {
  image: url(":/Images/Controls_Images_Dark/checkbox_indeterminate.png");
}

QMenu::indicator:non-exclusive:indeterminate:disabled {
  image: url(":/Images/Controls_Images_Dark/checkbox_indeterminate_disabled.png");
}

QMenu::indicator:non-exclusive:indeterminate:focus, QMenu::indicator:non-exclusive:indeterminate:hover, QMenu::indicator:non-exclusive:indeterminate:pressed {
  image: url(":/Images/Controls_Images_Dark/checkbox_indeterminate_focus.png");
}

QMenu::indicator:exclusive:unchecked {
  image: url(":/Images/Controls_Images_Dark/radio_unchecked.png");
}

QMenu::indicator:exclusive:unchecked:hover, QMenu::indicator:exclusive:unchecked:focus, QMenu::indicator:exclusive:unchecked:pressed {
  border: none;
  outline: none;
  image: url(":/Images/Controls_Images_Dark/radio_unchecked_focus.png");
}

QMenu::indicator:exclusive:unchecked:disabled {
  image: url(":/Images/Controls_Images_Dark/radio_unchecked_disabled.png");
}

QMenu::indicator:exclusive:checked {
  border: none;
  outline: none;
  image: url(":/Images/Controls_Images_Dark/radio_checked.png");
}

QMenu::indicator:exclusive:checked:hover, QMenu::indicator:exclusive:checked:focus, QMenu::indicator:exclusive:checked:pressed {
  border: none;
  outline: none;
  image: url(":/Images/Controls_Images_Dark/radio_checked_focus.png");
}

QMenu::indicator:exclusive:checked:disabled {
  outline: none;
  image: url(":/Images/Controls_Images_Dark/radio_checked_disabled.png");
}

QMenu::right-arrow {
  margin: 5px;
  padding-left: 12px;
  image: url(":/Images/Controls_Images_Dark/arrow_right.png");
  height: 12px;
  width: 12px;
}

QAbstractItemView {
  alternate-background-color: rgba(218, 218, 218, 0.3);
  color: #ffffff;
  border: 1px solid #404142;
  border-radius: 4px;
}

QAbstractItemView QLineEdit {
  padding: 2px;
}

QAbstractScrollArea {
  background-color: #e3e3e3;
  border: 1px solid #404142;
  border-radius: 4px;
  padding: 2px;
  color: #000000;
}

QAbstractScrollArea:disabled {
  color: #c8c8c8;
}

QScrollArea QWidget QWidget:disabled {
  background-color: #ffffff;
  color: #000000;
}

QScrollBar:horizontal {
  height: 16px;
  margin: 2px 16px 2px 16px;
  border: none;
  border-radius: 4px;
  background-color: #ffffff;
  color: #000000;
}

QScrollBar:vertical {
  background-color: #ffffff;
  width: 16px;
  margin: 16px 2px 16px 2px;
  border: none;
  border-radius: 4px;
  color: #000000;
}

QScrollBar::handle:horizontal {
  background-color: #cdcdcd;
  border: cdcdcd;
  border-radius: 4px;
  min-width: 8px;
}

QScrollBar::handle:horizontal:hover {
  background-color: #a6a6a6;
  border: #a6a6a6;
  border-radius: 4px;
  min-width: 8px;
}

QScrollBar::handle:horizontal:focus {
  border: 1px solid #404142;
}

QScrollBar::handle:vertical {
  background-color: #cdcdcd;
  border: 1px solid #cdcdcd;
  min-height: 8px;
  border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
  background-color: #a6a6a6;
  border: #a6a6a6;
  border-radius: 4px;
  min-height: 8px;
}

QScrollBar::handle:vertical:focus {
  border: 1px solid #404142;
}

QScrollBar::add-line:horizontal {
  margin: 0px 0px 0px 0px;
  border-image: url(":/Images/Controls_Images_Dark/arrow_right_disabled.png");
  height: 12px;
  width: 12px;
  subcontrol-position: right;
  subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:hover, QScrollBar::add-line:horizontal:on {
  border-image: url(":/Images/Controls_Images_Dark/arrow_right.png");
  height: 12px;
  width: 12px;
  subcontrol-position: right;
  subcontrol-origin: margin;
}

QScrollBar::add-line:vertical {
  margin: 3px 0px 3px 0px;
  border-image: url(":/Images/Controls_Images_Dark/arrow_down_disabled.png");
  height: 12px;
  width: 12px;
  subcontrol-position: bottom;
  subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover, QScrollBar::add-line:vertical:on {
  border-image: url(":/Images/Controls_Images_Dark/arrow_down.png");
  height: 12px;
  width: 12px;
  subcontrol-position: bottom;
  subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
  margin: 0px 3px 0px 3px;
  border-image: url(":/Images/Controls_Images_Dark/arrow_left_disabled.png");
  height: 12px;
  width: 12px;
  subcontrol-position: left;
  subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal:hover, QScrollBar::sub-line:horizontal:on {
  border-image: url(":/Images/Controls_Images_Dark/arrow_left.png");
  height: 12px;
  width: 12px;
  subcontrol-position: left;
  subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
  margin: 3px 0px 3px 0px;
  border-image: url(":/Images/Controls_Images_Dark/arrow_up_disabled.png");
  height: 12px;
  width: 12px;
  subcontrol-position: top;
  subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical:hover, QScrollBar::sub-line:vertical:on {
  border-image: url(":/Images/Controls_Images_Dark/arrow_up.png");
  height: 12px;
  width: 12px;
  subcontrol-position: top;
  subcontrol-origin: margin;
}

QScrollBar::up-arrow:horizontal, QScrollBar::down-arrow:horizontal {
  background: none;
}

QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
  background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
  background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: none;
}

QTextEdit {
  background-color: transparent;
  color: #ffffff;
  border-radius: 4px;
  border: 1px solid #404142;
}

QTextEdit:focus {
  border: 1px solid #404142;
}

QTextEdit:selected {
  background: #a6a6a6;
  color: #404142;
}

QPlainTextEdit {
  background-color: transparent;
  color: #ffffff;
  border-radius: 4px;
  border: 1px solid #404142;
}

QPlainTextEdit:focus {
  border: 1px solid #404142;
}

QPlainTextEdit:selected {
  background: #a6a6a6;
  color: #404142;
}

QSizeGrip {
  background: transparent;
  width: 12px;
  height: 12px;
  image: url(":/Images/Controls_Images_Dark/window_grip.png");
}

QStackedWidget {
  padding: 2px;
  border: 1px solid #404142;
  border: 1px solid #ffffff;
}

QToolBar {
  background-color: #404142;
  border-bottom: 1px solid #404142;
  padding: 1px;
  font-weight: bold;
  spacing: 2px;
}

QToolBar:disabled {
  background-color: #404142;
}

QToolBar::handle:horizontal {
  width: 16px;
  image: url(":/Images/Controls_Images_Dark/toolbar_move_horizontal.png");
}

QToolBar::handle:vertical {
  height: 16px;
  image: url(":/Images/Controls_Images_Dark/toolbar_move_vertical.png");
}

QToolBar::separator:horizontal {
  width: 16px;
  image: url(":/Images/Controls_Images_Dark/toolbar_separator_horizontal.png");
}

QToolBar::separator:vertical {
  height: 16px;
  image: url(":/Images/Controls_Images_Dark/toolbar_separator_vertical.png");
}

QToolButton#qt_toolbar_ext_button {
  background: #404142;
  border: 0px;
  color: #ffffff;
  image: url(":/Images/Controls_Images_Dark/arrow_right.png");
}

QAbstractSpinBox {
  background-color: transparent;
  border: 1px solid #404142;
  color: #ffffff;
  padding-top: 2px;
  padding-bottom: 2px;
  padding-left: 4px;
  padding-right: 4px;
  border-radius: 4px;
}

QAbstractSpinBox:up-button {
  background-color: #ffffff;
  subcontrol-origin: border;
  subcontrol-position: top right;
  border-left: 1px solid #404142;
  border-bottom: 1px solid #404142;
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  margin: 1px;
  width: 12px;
  margin-bottom: -1px;
  color: #000000;
}

QAbstractSpinBox::up-arrow, QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::up-arrow:off {
  image: url(":/Images/Controls_Images_Dark/arrow_up_disabled.png");
  height: 8px;
  width: 8px;
}

QAbstractSpinBox::up-arrow:hover {
  image: url(":/Images/Controls_Images_Dark/arrow_up.png");
}

QAbstractSpinBox:down-button {
  background-color: #ffffff;
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  border-left: 1px solid #404142;
  border-top: 1px solid #404142;
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  margin: 1px;
  width: 12px;
  margin-top: -1px;
  color: #000000;
}

QAbstractSpinBox::down-arrow, QAbstractSpinBox::down-arrow:disabled, QAbstractSpinBox::down-arrow:off {
  image: url(":/Images/Controls_Images_Dark/arrow_down_disabled.png");
  height: 8px;
  width: 8px;
}

QAbstractSpinBox::down-arrow:hover {
  image: url(":/Images/Controls_Images_Dark/arrow_down.png");
}

QAbstractSpinBox:hover {
  border: 1px solid #a6a6a6;
  color: #ffffff;
}

QAbstractSpinBox:focus {
  border: 1px solid #404142;
}

QAbstractSpinBox:selected {
  background: #a6a6a6;
  color: #404142;
}

/**** QMessageBox text color ****/
QMessageBox QLabel {
  color: #000000;
}

QLabel {
  background-color: transparent;
  border: 0px solid #404142;
  margin: 0px;
  color: #ffffff;
}

QLabel:disabled {
  background-color: transparent;
  border: 0px solid #404142;
  color: #c8c8c8;
}

QTextBrowser {
  background-color: transparent;
  border: 1px solid #404142;
  color: #000000;
  border-radius: 4px;
}

QTextBrowser:disabled {
  background-color: #ffffff;
  border: 1px solid #404142;
  color: #c8c8c8;
  border-radius: 4px;
  color: #000000;
}

QTextBrowser:hover, QTextBrowser:!hover, QTextBrowser:selected, QTextBrowser:pressed {
  border: 1px solid #404142;
}

QGraphicsView {
  background-color: transparent;
  border: 1px solid #404142;
  color: #000000;
  border-radius: 4px;
}

QGraphicsView:disabled {
  background-color: #ffffff;
  border: 1px solid #404142;
  color: #c8c8c8;
  border-radius: 4px;
}

QGraphicsView:hover, QGraphicsView:!hover, QGraphicsView:selected, QGraphicsView:pressed {
  border: 1px solid #404142;
}

QCalendarWidget {
  border: 1px solid #404142;
  border-radius: 4px;
}

QCalendarWidget:disabled {
  background-color: #ffffff;
  color: #000000;
}

QLCDNumber {
  background-color: transparent;
  color: #ffffff;
}

QLCDNumber:disabled {
  background-color: #ffffff;
  color: #000000;
}

QProgressBar {
  background-color: #ffffff;
  border: 1px solid #404142;
  color: #000000;
  border-radius: 4px;
  text-align: center;
}

QProgressBar:disabled {
  background-color: #ffffff;
  border: 1px solid #404142;
  color: #000000;
  border-radius: 4px;
  text-align: center;
}

QProgressBar::chunk {
  background-color: #a6a6a6;
  color: #ffffff;
  border-radius: 4px;
}

QProgressBar::chunk:disabled {
  background-color: #9c9c9c;
  color: #c8c8c8;
  border-radius: 4px;
}

QPushButton {
  background-color: #404142;
  color: #ffffff;
  border-radius: 4px;
  padding: 2px;
  outline: none;
  border: none;
}

QPushButton:disabled {
  background-color: #5e6061;
  color: #c8c8c8;
  border-radius: 4px;
  padding: 2px;
}

QPushButton:checked {
  background-color: #cdcdcd;
  border-radius: 4px;
  padding: 2px;
  outline: none;
}

QPushButton:checked:disabled {
  background-color: #5e6061;
  color: #c8c8c8;
  border-radius: 4px;
  padding: 2px;
  outline: none;
}

QPushButton:checked:selected {
  background: #cdcdcd;
}

QPushButton:hover {
  background-color: #828486;
  color: #ffffff;
}

QPushButton:pressed {
  background-color: #cdcdcd;
}

QPushButton:selected {
  background: #cdcdcd;
  color: #ffffff;
}

QPushButton::menu-indicator {
  subcontrol-origin: padding;
  subcontrol-position: bottom right;
  bottom: 4px;
}

QDialog {
  background-color: #ffffff;
  border: 1px solid #404142;
}

QToolButton {
  background-color: #404142;
  color: #ffffff;
  border-radius: 4px;
  padding: 2px;
  outline: none;
  border: none;
}

QToolButton:disabled {
  background-color: #5e6061;
  color: #c8c8c8;
  border-radius: 4px;
  padding: 2px;
}

QToolButton:checked {
  background-color: #cdcdcd;
  border-radius: 4px;
  padding: 2px;
  outline: none;
}

QToolButton:checked:disabled {
  background-color: #5e6061;
  color: #c8c8c8;
  border-radius: 4px;
  padding: 2px;
  outline: none;
}

QToolButton:checked:hover {
  background-color: #828486;
  color: #ffffff;
}

QToolButton:checked:pressed {
  background-color: #cdcdcd;
}

QToolButton:checked:selected {
  background: #cdcdcd;
  color: #ffffff;
}

QToolButton:hover {
  background-color: #828486;
  color: #ffffff;
}

QToolButton:pressed {
  background-color: #cdcdcd;
}

QToolButton:selected {
  background: #cdcdcd;
  color: #ffffff;
}

QToolButton[popupMode="0"] {
  padding-right: 2px;
}

QToolButton[popupMode="1"] {
  padding-right: 20px;
}

