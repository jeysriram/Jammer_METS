/*** Light Theme ***/
/* /!\  Do not change the above line since that is used for some runtime purpose. You can also use it if you need it, just mention whether the theme is dark or light /!\ */

QToolBar * {
  margin: 0px;
  padding: 0px;
}

QWidget{
  background-color: #ffffff;
}

QWidget::separator {
  background-color: #404142;
  border: 0px solid #ffffff;
  spacing: 0px;
  padding: 2px;
}

QWidget::separator:hover {
  background-color: #cdcdcd;
  border: 0px solid #404142;
}

QWidget::separator:horizontal {
  width: 5px;
  margin-top: 2px;
  margin-bottom: 2px;
  image: url(":/Images/Controls_Images_Dark/toolbar_separator_vertical.png");
}

QWidget::separator:vertical {
  height: 5px;
  margin-left: 2px;
  margin-right: 2px;
  image: url(":/Images/Controls_Images_Dark/toolbar_separator_horizontal.png");
}

QToolTip {
  background-color: #a6a6a6;
  color: #000000;
  border: none;
  padding: 0px;
}

QStatusBar {
  border: 1px solid #404142;
  background: #404142;
}

QStatusBar::item {
  border: none;
}

QStatusBar QToolTip {
  background-color: #404142;
  border: 1px solid #ffffff;
  color: #ffffff;
  padding: 0px;
  opacity: 230;
}

QStatusBar QLabel {
  background: transparent;
}

QCheckBox {
  background-color: transparent;
  color: #ffffff;
  spacing: 4px;
  outline: none;
}

QCheckBox:focus {
  border: none;
}

QCheckBox:disabled {
  background-color: transparent;
  color: #c8c8c8;
}

QCheckBox::indicator {
  margin-left: 2px;
  height: 14px;
  width: 14px;
}

/*QCheckBox::indicator:unchecked {
  image: url(":/Images/Controls_Images_Dark/checkbox_unchecked.png");
}

QCheckBox::indicator:unchecked:hover, QCheckBox::indicator:unchecked:focus, QCheckBox::indicator:unchecked:pressed {
  border: none;
  image: url(":/Images/Controls_Images_Dark/checkbox_unchecked_focus.png");
}

QCheckBox::indicator:unchecked:disabled {
  image: url(":/Images/Controls_Images_Dark/checkbox_unchecked_disabled.png");
}

QCheckBox::indicator:checked {
  image: url(":/Images/Controls_Images_Dark/checkbox_checked.png");
}

QCheckBox::indicator:checked:hover, QCheckBox::indicator:checked:focus, QCheckBox::indicator:checked:pressed {
  border: none;
  image: url(":/Images/Controls_Images_Dark/checkbox_checked_focus.png");
}

QCheckBox::indicator:checked:disabled {
  image: url(":/Images/Controls_Images_Dark/checkbox_checked_disabled.png");
}

QCheckBox::indicator:indeterminate {
  image: url(":/Images/Controls_Images_Dark/checkbox_indeterminate.png");
}

QCheckBox::indicator:indeterminate:disabled {
  image: url(":/Images/Controls_Images_Dark/checkbox_indeterminate_disabled.png");
}

QCheckBox::indicator:indeterminate:focus, QCheckBox::indicator:indeterminate:hover, QCheckBox::indicator:indeterminate:pressed {
  image: url(":/Images/Controls_Images_Dark/checkbox_indeterminate_focus.png");
}*/

QGroupBox[accessibleName = "gb_display"] {
  font-weight: bold;
  border: 1px solid #632126;
  border-radius: 4px;
  padding: 2px;
  margin-top: 4px;
  margin-bottom: 4px;
  background-color: transparent;
}

QGroupBox {
  font-weight: bold;
  border: 1px solid #404142;
  border-radius: 4px;
  padding: 2px;
  margin-top: 4px;
  margin-bottom: 4px;
  background-color: rgba(64, 65, 66, 0.7);
}

QGroupBox::title {
  subcontrol-origin: margin;
  /*subcontrol-position: top left;*/
  left: 4px;
  padding-left: 2px;
  padding-right: 4px;
  padding-top: -2px;
  color: #ffffff;
  border-radius: 2px;
  background-color: rgba(64, 65, 66, 0.7);
}

QGroupBox::indicator {
  margin-left: 2px;
  margin-top: 2px;
  padding: 0;
  height: 14px;
  width: 14px;
}

QGroupBox::indicator:unchecked {
  border: none;
  image: url(":/Images/Controls_Images_Dark/checkbox_unchecked.png");
}

QGroupBox::indicator:unchecked:hover, QGroupBox::indicator:unchecked:focus, QGroupBox::indicator:unchecked:pressed {
  border: none;
  image: url(":/Images/Controls_Images_Dark/checkbox_unchecked_focus.png");
}

QGroupBox::indicator:unchecked:disabled {
  image: url(":/Images/Controls_Images_Dark/checkbox_unchecked_disabled.png");
}

QGroupBox::indicator:checked {
  border: none;
  image: url(":/Images/Controls_Images_Dark/checkbox_checked.png");
}

QGroupBox::indicator:checked:hover, QGroupBox::indicator:checked:focus, QGroupBox::indicator:checked:pressed {
  border: none;
  image: url(":/Images/Controls_Images_Dark/checkbox_checked_focus.png");
}

QGroupBox::indicator:checked:disabled {
  image: url(":/Images/Controls_Images_Dark/checkbox_checked_disabled.png");
}

QRadioButton {
  background-color: transparent;
  color: #ffffff;
  spacing: 2px;
  padding-top: 2px;
  padding-bottom: 2px;
}

QRadioButton:focus {
  border: none;
}

QRadioButton:disabled {
  background-color: transparent;
  color: #c8c8c8;
}

QRadioButton QWidget {
  background-color: transparent;
  color: #ffffff;
  spacing: 0px;
  padding: 0px;
}

QRadioButton::indicator {
  margin-left: 2px;
  height: 14px;
  width: 14px;
}

