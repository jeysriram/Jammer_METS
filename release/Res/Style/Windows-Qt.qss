  background-color: #ffffff;
  color: #000000;
}

QToolBox::tab:hover {
  border-color: #404142;
  border-bottom: 2px solid #404142;
}

QToolBox QScrollArea QWidget QWidget {
  padding: 0px;
  border: 0px;
  background-color: #ffffff;
  color: #000000;
}

.QFrame {
  border-radius: 4px;
  border: 1px solid #404142;
}

.QFrame[frameShape="0"] {
  border-radius: 4px;
  border: 1px transparent #404142;
}

.QFrame[frameShape="4"] {
  max-height: 2px;
  border: none;
  background-color: #404142;
}

.QFrame[frameShape="5"] {
  max-width: 2px;
  border: none;
  background-color: #404142;
}

QSplitter {
  background-color: transparent;
  spacing: 0px;
  padding: 0px;
  margin: 0px;
}

QSplitter::handle {
  background-color: transparent;
  border: 0px solid #ffffff;
  spacing: 0px;
  padding: 1px;
  margin: 0px;
}

QSplitter::handle:hover {
  background-color: #c8c8c8;
}

QSplitter::handle:horizontal {
  width: 5px;
  image: url(":/Images/Controls_Images_Dark/line_vertical.png");
}

QSplitter::handle:vertical {
  height: 5px;
  image: url(":/Images/Controls_Images_Dark/line_horizontal.png");
}

QDateEdit, QDateTimeEdit {
  selection-background-color: #a6a6a6;
  border-style: solid;
  border: 1px solid #404142;
  border-radius: 4px;
  padding-top: 2px;
  padding-bottom: 2px;
  padding-left: 4px;
  padding-right: 4px;
  min-width: 10px;
}

QDateEdit:on, QDateTimeEdit:on {
  selection-background-color: #a6a6a6;
}

QDateEdit::drop-down, QDateTimeEdit::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 12px;
  border-left: 1px solid #404142;
}

QDateEdit::down-arrow, QDateTimeEdit::down-arrow {
  image: url(":/Images/Controls_Images_Dark/arrow_down_disabled.png");
  height: 8px;
  width: 8px;
}

QDateEdit::down-arrow:on, QDateEdit::down-arrow:hover, QDateEdit::down-arrow:focus, QDateTimeEdit::down-arrow:on, QDateTimeEdit::down-arrow:hover, QDateTimeEdit::down-arrow:focus {
  image: url(":/Images/Controls_Images_Dark/arrow_down.png");
}

QDateEdit QAbstractItemView, QDateTimeEdit QAbstractItemView {
  background-color: #ffffff;
  border-radius: 4px;
  border: 1px solid #404142;
  selection-background-color: #a6a6a6;
  color: #000000;
}

QAbstractView:hover {
  border: 1px solid #a6a6a6;
  color: #ffffff;
}

QAbstractView:selected {
  background: #a6a6a6;
  color: #404142;
}

PlotWidget {
  padding: 0px;
}

/*------------------ Status Bar ------------------------ */

QPushButton[accessibleName="StatusBarPushButton"]{
  background-color: #404142;
  color: #000000;
  border-radius: 4px;
  padding: 2px;
  outline: none;
  border: none;
}

QLabel[accessibleName="StatusBarSpacerLabel"]{
  color: #404142;
}

QPushButton[accessibleName="Spectra_Icons"]:checked {
  background-color: #404142;
  border: 1px solid #404142;
  border-radius: 4px;
  padding: 2px;
}

QPushButton[accessibleName="Spectra_Icons"]:!checked {
  background-color: transparent;
  border: 1px solid #404142;
  border-radius: 4px;
  padding: 2px;
}

