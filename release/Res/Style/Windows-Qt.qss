QMenuBar {
  background-color: #d2d2d2;
  padding: 2px;
  border: 1px solid #d2d2d2;
  color: #000000;
  selection-background-color: #404142;
}

QMenuBar:focus {
  border: 1px solid #a6a6a6;
}

QMenuBar::item {
  background: transparent;
  padding: 4px;
}

QMenuBar::item:selected {
  padding: 4px;
  background: transparent;
  border: 0px solid #404142;
  background-color: #bbbbbb;
}

QMenuBar::item:pressed {
  padding: 4px;
  border: 0px solid #404142;
  background-color: #bbbbbb;
  color: #000000;
  margin-bottom: 0px;
  padding-bottom: 0px;
}

QMenu {
  border: 0px solid #404142;
  color: #000000;
  margin: 0px;
  background-color: #c9ebf7;
  selection-background-color: #404142;
}

QMenu::separator {
  height: 1px;
  background-color: #cdcdcd;
  color: #ffffff;
}

QMenu::item {
  background-color: #b4b9ba;
  padding: 4px 24px 4px 10px;
  border: 1px transparent #404142;
}

QMenu::item:selected {
  color: #ffffff;
  background-color: #404142;
}

QMenu::item:pressed {
  background-color: #404142;
}

QMenu::icon {
  padding-left: 10px;
  width: 14px;
  height: 14px;
}

QMenu::indicator {
  padding-left: 8px;
  width: 12px;
  height: 12px;
}

/********** Commented for light theme due to image visibility **********/

